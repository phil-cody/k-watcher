# Скопируйте в .env и заполните локально. НЕ коммитить .env и не присылать секреты в чат.

# --- Telegram (обязательно для режимов bot/poll) ---
# Токен получите у @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram user id — вы владелец бота (видит /users и /usage).
# Как узнать: напишите @userinfobot. Необязательно: если не задан, владельцем
# станет первый написавший боту.
#
# Доступ открыт: любой, кто напишет боту /start, подключается сразу (событие
# логируется). Подтверждать пользователей не нужно. Список подключённых живёт в
# data/telegram-state.json и переживает перезапуск. Чтобы закрыть доступ,
# поставьте в config/default.json → telegram.autoApprove = false.
TELEGRAM_ALLOWED_USER_ID=
# Необязательно: id чата, куда слать уведомления. По умолчанию — чат из первого сообщения.
TELEGRAM_CHAT_ID=
# --- Модель анализа (необязательно; по умолчанию выключено) ---
# По умолчанию heuristic: анализ полностью локальный, без внешних вызовов и оплаты.
# MODEL_PROVIDER=heuristic | openai-compatible | anthropic
MODEL_PROVIDER=heuristic

# Бесплатные варианты подключаются как openai-compatible.
# Подробное руководство с лимитами и проверкой: docs/MODEL-SETUP.md
#
# Groq (рекомендуется: ~1000 запросов/сутки бесплатно, ключ: https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (ключ бесплатно: https://aistudio.google.com/apikey; лимиты новых моделей низкие)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-latest
#
# OpenRouter (бесплатные модели с суффиксом :free; лимит ~50/сутки, ростер меняется)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # быстрая 120B, надёжнее 550B Ultra
#
# Локальная Ollama (без ключа и без лимитов)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
#
# ВАЖНО: URL указывается БЕЗ /chat/completions — приложение само добавит его.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Для anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Тексты интерфейса ---
# Необязательно: локальный файл с формулировками (сообщения, логи, CLI).
# Он переопределяет config/texts.json, поэтому репозиторий остаётся нетронутым.
# Скопируйте нужные ключи из config/texts.json в свой файл и укажите путь здесь.
TEXTS_FILE=

# --- Прочее ---
# Папка состояния
DATA_DIR=data
