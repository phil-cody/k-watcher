# Скопируйте в .env и заполните локально. НЕ коммитить .env и не присылать секреты в чат.

# --- Telegram (обязательно для режимов bot/poll) ---
# Токен получите у @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram user id — вы владелец бота.
# Как узнать: напишите @userinfobot или посмотрите в логе запрос доступа.
#
# ВАЖНО: остальных пользователей сюда добавлять не нужно.
# Они подключаются сами: пишут боту /start, а вы подтверждаете командой
# /approve <id>. Список доступа живёт в data/telegram-state.json и переживает
# перезапуск. Все подтверждённые получают уведомления о заданиях.
TELEGRAM_ALLOWED_USER_ID=
# Необязательно: id чата, куда слать уведомления. По умолчанию — чат из первого сообщения.
TELEGRAM_CHAT_ID=
# --- Модель анализа (необязательно; по умолчанию выключено) ---
# По умолчанию heuristic: анализ полностью локальный, без внешних вызовов и оплаты.
# MODEL_PROVIDER=heuristic | openai-compatible | anthropic
MODEL_PROVIDER=heuristic

# Бесплатные варианты подключаются как openai-compatible.
# Подробное руководство с лимитами и проверкой: docs/MODEL-SETUP.md
#
# Google Gemini (рекомендуется, ключ бесплатно: https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
#
# Groq (быстрый, ключ бесплатно: https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (бесплатные модели с суффиксом :free)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat-v3.1:free
#
# Локальная Ollama (без ключа и без лимитов)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
#
# ВАЖНО: URL указывается БЕЗ /chat/completions — приложение само добавит его.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Для anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Тексты интерфейса ---
# Необязательно: локальный файл с формулировками (сообщения, логи, CLI).
# Он переопределяет config/texts.json, поэтому репозиторий остаётся нетронутым.
# Скопируйте нужные ключи из config/texts.json в свой файл и укажите путь здесь.
TEXTS_FILE=

# --- Прочее ---
# Папка состояния
DATA_DIR=data
